# Copy to .env. Credentials stay on this local Python server, never in the browser.
# Use a vision-capable, tool-calling model supported by your provider and LiteLLM.
BRICKWRIGHT_GENERATION_MODEL=
OPENAI_API_KEY=
# OpenAI-compatible hosts can be configured with a versioned API base.
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_STREAM=true
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# For Moonshot use BRICKWRIGHT_GENERATION_MODEL=moonshot/kimi-k3.1-pro
# MOONSHOT_API_KEY=
# MOONSHOT_API_BASE=https://api.moonshot.cn/v1
# MOONSHOT_MAX_OUTPUT_TOKENS=16384
# The model supports up to 1048576; 131072 gives max effort more output room.
# Applied to builder and both visual-review agents; low, high (default), or max.
# MOONSHOT_REASONING_EFFORT=high
# MOONSHOT_STREAM=true
# China kimi-k3.1-pro prices: CNY 13 input / 1.30 cached input / 68 output
# per million tokens, including reasoning (verified 2026-11-02).
# Set a conservative USD per CNY conversion for the USD budget estimate. The
# report also records CNY cost and this conversion. No default is assumed.
# MOONSHOT_USD_PER_CNY=0.16

# Leave blank to use ~/.cache/brick-it/ldraw. Missing libraries are downloaded
# from this project's pinned GitHub Release and verified before extraction.
# Set a custom directory to reuse an existing installation instead.
LDRAW_LIBRARY_PATH=
BRICK_IT_AUTO_DOWNLOAD_LDRAW=true

# Per-job generation limits, including the visual critique loop.
# Cost tracking is post-response; the last provider call can cross the limit.
# Set MAX_COST, JOB_TIMEOUT or REQUEST_TIMEOUT to 0 (or unlimited) to remove
# that limit explicitly. Unknown usage/price still stops further paid calls.
# MAX_TURNS and MAX_VALIDATIONS also accept 0 (or unlimited) to remove caps.
BRICK_IT_MAX_COST=1.0
BRICK_IT_MAX_TURNS=80
BRICK_IT_MAX_VALIDATIONS=30
# At most one visual review and one revision; legacy higher values are capped.
BRICK_IT_MAX_CRITIQUE_ROUNDS=1
BRICK_IT_MAX_VIEWPOINT_ITERATIONS=3
BRICK_IT_JOB_TIMEOUT=900
BRICK_IT_REQUEST_TIMEOUT=120
# Includes source photos, official SDK records, and approved downloadable artifacts.
BRICK_IT_RECORDS_DIR=.brick-it-records
