# Copy to .env. Credentials stay on this local Python server, never in the browser.
# Use a vision-capable, tool-calling model supported by your provider and LiteLLM.
BRICKWRIGHT_GENERATION_MODEL=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Extract the official LDraw parts library, then point at its ldraw directory.
# Download: https://library.ldraw.org/updates?latest
LDRAW_LIBRARY_PATH=

# Per-job generation limits, including the visual critique loop.
# Cost tracking is post-response; the last provider call can cross the limit.
BRICK_IT_MAX_COST=1.0
BRICK_IT_MAX_TURNS=80
BRICK_IT_MAX_VALIDATIONS=30
BRICK_IT_JOB_TIMEOUT=900
BRICK_IT_REQUEST_TIMEOUT=120
# Includes source photos, official SDK records, and approved downloadable artifacts.
BRICK_IT_RECORDS_DIR=.brick-it-records
